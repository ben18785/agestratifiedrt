// Hidden-infections version of stan/england.stan.
//
// Infections X[t, j] are unknown and generated by the multi-group renewal equation, with weekly
// noise in each group's transmission; cases and the ONS Infection Survey are two noisy
// observations of them:
//   X[t, j]  = R[week] * (Gn' Lam_t)[j] * exp(sigma_eta * eta[j, week]),
//              Lam_t[i] = sum_s w[i, s] X[t - s, i]
//   Y[t, j]  ~ NegBin(q[t, j] * 7 * dow[j, weekday] * sum_d f[d] X[t - d, j], phi)
//   n_pos    ~ Binomial(n_tested, mean over the window of sum_u d[u] X[t - u, j] / Npop[j])
// Gn = G / rho(G), G = diag(a) C diag(b .* v_eff), as in england.stan, so R is the long-run
// reproduction number. The infection time line starts L days before the first day of data;
// infections in those L days grow exponentially from a seed.
// Unlike england.stan, cases do not fix the timing or size of infections: noise in cases stays
// observation noise, and the survey informs infections directly.
data {
  int<lower=1> T;                          // number of days of data
  int<lower=1> N;                          // number of groups
  int<lower=1> S;                          // longest generation time considered (days)
  int<lower=S> L;                          // seeding days before day 1
  int<lower=1, upper=T> t0;                // first day whose cases enter the likelihood
  array[T, N] int<lower=0> Y;              // cases by specimen date and group
  matrix[N, S] w;                          // generation-time distribution of each group
  int<lower=1, upper=L + 1> Dd;            // longest delay from infection to specimen date + 1
  matrix[N, Dd] f;                         // f[j, d + 1] = P(delay = d days) for group j
  int<lower=1> B;                          // number of blocks (weeks) for R
  array[T] int<lower=1, upper=B> block;    // block of each day
  int<lower=1> nP;                         // number of matrix periods (weeks)
  array[T] int<lower=1, upper=nP> period;  // matrix period of each day
  array[nP] int<lower=1, upper=T> pstart;  // first day of each period
  array[nP] matrix<lower=0>[N, N] C;       // contact matrix per period (rows: infectors)
  array[nP] vector<lower=0, upper=1>[N] v; // susceptibility factor from vaccination per period
  int<lower=0, upper=1> deplete;           // 1: susceptibility falls with infections since day 1
  vector<lower=0, upper=1>[N] s0;          // susceptible fraction on day 1 (for deplete)
  int<lower=0, upper=1> adapt;             // 1: each group's susceptibility and infectiousness follow
                                           //    a weekly random walk (log A), split by rho
  array[T] int<lower=1, upper=7> dow;      // day of the week of each day
  int<lower=0, upper=1> est_q;             // 1: reporting varies by week; 0: constant
  int<lower=0, upper=1> tau_by_group;      // 1: each group has its own sd of weekly reporting steps
  int<lower=1> W;                          // number of weeks for reporting
  array[T] int<lower=1, upper=W> qweek;    // reporting week of each day
  int<lower=0, upper=1> ons;               // 1: use the infection survey
  vector<lower=0>[N] Npop;                 // population of each group
  int<lower=1> D;                          // days for which an infection can test positive
  vector<lower=0, upper=1>[D] d;           // d[u + 1] = P(PCR positive u days after infection)
  int<lower=0> K;                          // number of survey windows
  array[K] int<lower=1, upper=T> win_start;  // first day of each window (needs win_start + L >= D)
  array[K] int<lower=1, upper=T> win_end;    // last day of each window
  array[K, N] int<lower=0> n_tested;       // people tested per window and group
  array[K, N] int<lower=0> n_pos;          // positives per window and group
  vector[N] lx0_mean;                      // prior mean of log daily infections at the seed
}
transformed data {
  int TI = L + T;                          // length of the infection time line
  int nq = tau_by_group ? N : 1;           // number of reporting sds
}
parameters {
  vector<lower=0>[N - 1] a_raw;            // infectiousness / reporting, groups 2..N (group 1 = 1)
  vector<lower=0>[N - 1] b_raw;            // susceptibility x reporting, groups 2..N (group 1 = 1)
  real logR1;                              // log R in the first block
  vector[B - 1] z;                         // standardised weekly steps in log R
  real<lower=0> tau;                       // sd of weekly steps in log R
  matrix[N, B] eta;                        // standardised weekly transmission noise by group
  real<lower=0> sigma_eta;                 // sd of that noise
  vector[N] lx0;                           // log daily infections on day 0 (seed)
  real r0;                                 // daily growth rate during seeding
  real<lower=0> inv_phi;                   // negative-binomial overdispersion
  array[N] simplex[7] dw;                  // day-of-week shares of each group's cases
  array[est_q] matrix[N, W - 1] uz;        // standardised weekly steps in log (or logit) reporting
  array[est_q] vector<lower=0>[nq] tau_q;  // sd of those steps (one, or one per group)
  vector[ons ? N : 0] lq0;                 // logit reporting in week 1, if the survey is used
  matrix[adapt ? N - 1 : 0, adapt ? nP - 1 : 0] Az;  // standardised weekly steps in log A, groups 2..N
  array[adapt] real<lower=0> sigA;         // sd of those steps
  array[adapt] real<lower=0, upper=1> rho; // share of log A that is susceptibility (rest: infectiousness)
}
transformed parameters {
  vector[B] R;                             // long-run reproduction number by block
  array[nP] matrix[N, N] Gn;               // normalised matrix shape by period
  matrix[N, nP] logA;                      // log A by group and period (group 1 = 0; 0 if adapt = 0)
  matrix[TI, N] X;                         // infections (rows: L seeding days, then days 1..T)
  matrix[T, N] q;                          // reporting probability (or relative reporting)
  matrix[T, N] rep;                        // q times the day-of-week effect
  {
    vector[B] lr;
    lr[1] = logR1;
    for (b in 2:B) lr[b] = lr[b - 1] + tau * z[b - 1];
    R = exp(lr);
  }
  {
    matrix[N, W] u = rep_matrix(0, N, W);  // weekly log (or logit) reporting relative to week 1
    if (est_q) {
      vector[N] sd_q = tau_by_group ? tau_q[1] : rep_vector(tau_q[1][1], N);
      for (k in 2:W) u[, k] = u[, k - 1] + sd_q .* uz[1][, k - 1];
    }
    for (t in 1:T) for (i in 1:N) {
      q[t, i] = ons ? inv_logit(lq0[i] + u[i, qweek[t]]) : exp(u[i, qweek[t]]);
      rep[t, i] = q[t, i] * 7 * dw[i][dow[t]];
    }
  }
  {
    vector[N] a = append_row(1, a_raw);
    vector[N] b = append_row(1, b_raw);
    vector[N] cum = rep_vector(0, N);      // infections since day 1 as a fraction of the population
    int k = 0;
    vector[N] lA = rep_vector(0, N);
    for (t in 1:L) X[t] = exp(lx0 + r0 * (t - L))';
    for (td in 1:T) {
      int t = L + td;
      if (k < nP && td == pstart[k + 1]) {  // new period: update its matrix shape
        k += 1;
        if (adapt && k > 1) lA[2:N] += sigA[1] * Az[, k - 1];
        logA[, k] = lA;
        vector[N] veff = deplete ? fmax(v[k] - cum ./ s0, 0.02) : v[k];
        vector[N] sus = adapt ? exp(rho[1] * lA) : rep_vector(1, N);
        vector[N] inf = adapt ? exp((1 - rho[1]) * lA) : rep_vector(1, N);
        matrix[N, N] G = diag_pre_multiply(a .* inf, diag_post_multiply(C[k], b .* veff .* sus));
        if (is_inf(sum(G)) || is_nan(sum(G)) || sum(G) <= 0) reject("G not finite and positive");
        Gn[k] = G / max(abs(eigenvalues(G)));
      }
      vector[N] Lam = rep_vector(0, N);
      for (i in 1:N) for (s in 1:S) Lam[i] += w[i, s] * X[t - s, i];
      X[t] = (R[block[td]] * (Gn[period[td]]' * Lam) .* exp(sigma_eta * eta[, block[td]]))';
      cum += X[t]' ./ Npop;
    }
  }
}
model {
  a_raw ~ lognormal(0, 1);
  b_raw ~ lognormal(0, 1);
  logR1 ~ normal(0, 0.5);
  z ~ std_normal();
  tau ~ normal(0, 0.2);
  to_vector(eta) ~ std_normal();
  sigma_eta ~ normal(0, 0.1);
  lx0 ~ normal(lx0_mean, 1);
  r0 ~ normal(0, 0.05);
  inv_phi ~ normal(0, 1);
  for (i in 1:N) dw[i] ~ dirichlet(rep_vector(10, 7));
  for (k in 1:est_q) {
    to_vector(uz[k]) ~ std_normal();
    tau_q[k] ~ normal(0, 0.3);
  }
  lq0 ~ normal(-1, 1.5);
  to_vector(Az) ~ std_normal();
  sigA ~ normal(0, 0.15);                  // about 0.2 per fortnight, as in Hinch et al. 2025
  rho ~ beta(2, 2);
  // cases: reporting x day of week x infections convolved with the delay to specimen date
  for (td in t0:T) {
    int t = L + td;
    for (j in 1:N) {
      real inc = 0;
      for (dd in 1:Dd) inc += f[j, dd] * X[t - dd + 1, j];
      Y[td, j] ~ neg_binomial_2(fmax(rep[td, j] * inc, 1e-8), 1 / inv_phi);
    }
  }
  // infection survey
  if (ons) {
    for (kk in 1:K) for (j in 1:N) {
      real prev = 0;
      for (td in win_start[kk]:win_end[kk])
        for (uu in 0:(D - 1)) prev += d[uu + 1] * X[L + td - uu, j] / Npop[j];
      prev /= (win_end[kk] - win_start[kk] + 1);
      n_pos[kk, j] ~ binomial(n_tested[kk, j], fmin(prev, 1 - 1e-9));
    }
  }
}
generated quantities {
  // modelled ONS positivity (%) per window and group, for checking the fit
  array[K] vector[N] prev_pct;
  for (kk in 1:K) for (j in 1:N) {
    real prev = 0;
    for (td in win_start[kk]:win_end[kk])
      for (uu in 0:(D - 1)) prev += d[uu + 1] * X[L + td - uu, j] / Npop[j];
    prev_pct[kk][j] = 100 * prev / (win_end[kk] - win_start[kk] + 1);
  }
}
